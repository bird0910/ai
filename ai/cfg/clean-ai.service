# clean-ai.service--save to /etc/systemd/system/clean-ai.service. Makes clean-ai.sh run automatically as a service/daemon.
#
[Unit]
Description=Clean up and optimize local AI environment
After=network.target

[Service]
Type=oneshot
ExecStart=/abs/path/to/clean-ai.sh # modify with local bin path/clean-ai.sh

[Install]
WantedBy=multi-user.target
